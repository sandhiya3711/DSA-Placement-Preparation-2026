Maximum Subarray — Brute Force

Find the contiguous subarray with the largest sum.

import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int max = arr[0];

        for (int i = 0; i < n; i++) {

            int sum = 0;

            for (int j = i; j < n; j++) {

                sum = sum + arr[j];

                if (sum > max) {
                    max = sum;
                }
            }
        }

        System.out.println(max);
    }
}

Input

9
-2 1 -3 4 -1 2 1 -5 4

Output

6
Complexity
Time: O(n²)
Space: O(1)

Maximum Subarray — Optimal (Kadane's Algorithm)
import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int sum = arr[0];
        int max = arr[0];

        for (int i = 1; i < n; i++) {

            sum = Math.max(arr[i], sum + arr[i]);

            max = Math.max(max, sum);
        }

        System.out.println(max);
    }
}

Complexity:

Time: O(n)
Space: O(1)
